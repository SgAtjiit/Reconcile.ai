PORT=5000
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
NODE_ENV=development

# OpenRouter API Configuration (Zero Hardcoding)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Matching Engine Dynamic Parameters
LLM_CONFIDENCE_THRESHOLD=0.60
LLM_BATCH_SIZE=15
LLM_TIMEOUT_MS=12000
SITE_URL=http://localhost:5000
SITE_NAME=Reconcile.ai
